# Vertex AI Nano Banana / Gemini image model settings
# Copy this file to .env and fill in your values

# Google Cloud Vertex AI configuration
# Use Vertex AI with authenticated credentials (recommended for production)
GOOGLE_GENAI_USE_VERTEXAI=true
GOOGLE_CLOUD_PROJECT=your-google-cloud-project-id
GOOGLE_CLOUD_LOCATION=global
NANO_BANANA_MODEL=gemini-3.1-flash-image
# --- Item 23: Gemini text model used by the POST /consult AI consultant endpoint ---
# Defaults to gemini-2.5-flash when unset. Use a different alias if you prefer.
GOOGLE_TEXT_MODEL=gemini-2.5-flash

# Optional fallback when GOOGLE_GENAI_USE_VERTEXAI=false
# Only needed if using API key mode instead of Vertex AI
GOOGLE_API_KEY=
GEMINI_API_KEY=

# Backend server settings
API_HOST=0.0.0.0
API_PORT=3003

# For local development - used by frontend to connect to backend
LOMAR_API_URL=http://localhost:3003

# --- Frontend (Vite) env vars, consumed by the frontend React app ---
# These are NOT read by the backend; document them here so ops/devs know the
# full set. In practice they are set in the FRONTEND .env.local (repo root),
# not in backend/.env. Listed here only as a reference catalogue.
# VITE_VTON_BACKEND_URL = the VTON backend base URL (e.g. http://localhost:3003
#   or the Cloud Run URL). Already used by vite.config.ts + workflows.
# VITE_VTON_ENDPOINT = the endpoint PATH on that backend
#   (e.g. /test-try-on-upload). Canonical path name, matches README.

# CORS allowed origins (comma-separated for production)
# Set to your GitHub Pages URL in production, e.g.:
# ALLOWED_ORIGINS=https://your-username.github.io
# IMPORTANT: a deployed backend with ALLOWED_ORIGINS unset falls back to
# localhost-only and will BLOCK the GitHub Pages frontend. Always set this
# for production. (Item 15 / deployment-readiness finding F3)
ALLOWED_ORIGINS=*

# --- Item 16 (auth): Supabase JWT verification on the backend ---
# When ENABLE_AUTH=true, the /test-try-on*, /proxy-image, and /consult
# endpoints require a valid Supabase access token in the
# `Authorization: Bearer <jwt>` header (the frontend's session.access_token).
# Copy SUPABASE_JWT_SECRET from the Supabase dashboard:
#   Project Settings -> API -> JWT Secret
# Leave ENABLE_AUTH=false for a gated beta (rate limiting is the only barrier).
ENABLE_AUTH=false
SUPABASE_JWT_SECRET=
# Supabase access tokens use audience "authenticated" by default; the anon key
# (audience "apikey") is intentionally rejected when auth is enabled.
SUPABASE_JWT_AUDIENCE=authenticated