# HTTP server
API_HOST=0.0.0.0
API_PORT=8080
ALLOWED_ORIGINS=http://localhost:3000

# Supabase
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# These compatibility names accept Supabase's current publishable and secret
# key formats. The secret key must remain server-side.
SUPABASE_ANON_KEY=sb_publishable_REPLACE_ME
SUPABASE_SERVICE_ROLE_KEY=sb_secret_REPLACE_ME
SUPABASE_JWT_ISSUER=https://YOUR_PROJECT.supabase.co/auth/v1
SUPABASE_JWT_AUDIENCE=authenticated

# Dedicated consultant agent service
AGENT_SERVICE_URL=http://localhost:8090
AGENT_SERVICE_INTERNAL_KEY=GENERATE_A_LONG_RANDOM_SECRET

# Text generation used by chat thread replies
AI_TEXT_PROVIDER=openai
OPENAI_API_KEY=REPLACE_ME
OPENAI_BASE_URL=
AI_TEXT_MODEL=YOUR_MODEL_NAME
